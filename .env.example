# Supabase project settings — Project Settings > API in the Supabase dashboard.
# Copy this file to .env.local and fill in the real values. Never commit .env.local.

# Public: safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret: server-only, used by API routes (e.g. inviting coordinators).
# Never prefix this with NEXT_PUBLIC_ — it must never reach the browser.
SUPABASE_SERVICE_ROLE_KEY=
